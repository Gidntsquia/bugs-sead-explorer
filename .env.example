# Copy to .env and change as needed. All paths are relative to the project folder.
# Where the BugsCEP SQLite file lives (make it with ./scripts/get-bugs-data.sh)
BUGS_DB=data/bugs.sqlite
# Port and address the app listens on (use HOST=0.0.0.0 to reach it from other machines)
PORT=5178
HOST=127.0.0.1
# SEAD's public read-only API
SEAD_URL=https://browser.sead.se/postgrest
# Where SEAD answers are cached, and for how long (hours)
CACHE_DIR=data/cache
SEAD_CACHE_HOURS=24
